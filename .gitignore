# .gitignore for RO Customer Management

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules
.pnp
.pnp.js

# Production
dist
dist-ssr
build
*.tsbuildinfo

# Environment variables
.env
*.local
.env.development.local
.env.test.local
.env.production.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Backups
backups/
*.backup
*.bak

# OS files
Thumbs.db

# Misc
*.tgz
*.zip
*.tar.gz
.cache/
temp/
tmp/
